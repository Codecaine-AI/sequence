      "children": [
        "b-00-overview-json-remains-authorita-9-s1"
      ]
    },
    "b-00-overview-json-remains-authorita-9-s1": {
      "id": "b-00-overview-json-remains-authorita-9-s1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The program is an agent-facing view, not a second persistence format."
        }
      ],
      "children": []
    },
    "b-00-overview-rewrites-replace-the-w-11": {
      "id": "b-00-overview-rewrites-replace-the-w-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Rewrites replace the whole program.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-00-overview-rewrites-replace-the-w-11-s1",
        "b-00-overview-rewrites-replace-the-w-11-s2"
      ]
    },
    "b-00-overview-rewrites-replace-the-w-11-s1": {
      "id": "b-00-overview-rewrites-replace-the-w-11-s1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "There is no text patch DSL."
        }
      ],
      "children": []
    },
    "b-00-overview-rewrites-replace-the-w-11-s2": {
      "id": "b-00-overview-rewrites-replace-the-w-11-s2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Parsing either produces a validated replacement structure or line-numbered errors."
        }
      ],
      "children": []
    },
    "b-00-overview-numbers-are-identity-13": {
      "id": "b-00-overview-numbers-are-identity-13",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Numbers are identity.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-00-overview-numbers-are-identity-13-s1"
      ]
    },
    "b-00-overview-numbers-are-identity-13-s1": {
      "id": "b-00-overview-numbers-are-identity-13-s1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Participants are declared densely as "
        },
        {
          "insert": "1..n",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", in column order, and every message or note refers to those numbers."
        }
      ],
      "children": []
    },
    "b-00-overview-structure-goes-in-geo-15": {
      "id": "b-00-overview-structure-goes-in-geo-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Structure goes in, geometry comes out.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-00-overview-structure-goes-in-geo-15-s1",
        "b-00-overview-structure-goes-in-geo-15-s2"
      ]
    },
    "b-00-overview-structure-goes-in-geo-15-s1": {
      "id": "b-00-overview-structure-goes-in-geo-15-s1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Two-space indentation expresses nesting."
        }
      ],
      "children": []
    },
    "b-00-overview-structure-goes-in-geo-15-s2": {
      "id": "b-00-overview-structure-goes-in-geo-15-s2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "No position, size, path, or other coordinate appears in the text."
        }
      ],
      "children": []
    },
    "b-00-overview-style-is-fully-separat-17": {
      "id": "b-00-overview-style-is-fully-separat-17",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Style is fully separated.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-00-overview-style-is-fully-separat-17-s1",
        "b-00-overview-style-is-fully-separat-17-s2"
      ]
    },
    "b-00-overview-style-is-fully-separat-17-s1": {
      "id": "b-00-overview-style-is-fully-separat-17-s1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Colors and scale live in "
        },
        {
          "insert": "SequenceDocument.style",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-style-is-fully-separat-17-s2": {
      "id": "b-00-overview-style-is-fully-separat-17-s2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Serialization never emits them, and a program rewrite preserves the existing style."
        }
      ],
      "children": []
    },
    "b-00-overview-expansion-is-determini-19": {
      "id": "b-00-overview-expansion-is-determini-19",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Expansion is deterministic.",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-00-overview-expansion-is-determini-19-s1"
      ]
    },
    "b-00-overview-expansion-is-determini-19-s1": {
      "id": "b-00-overview-expansion-is-determini-19-s1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Parsing regenerates stable internal ids and layout derives rows, frames, lifelines, arrow docking, notes, and activation bars from structure alone."
        }
      ],
      "children": []
    },
    "b-00-overview-this-separation-keeps-pr-21": {
      "id": "b-00-overview-this-separation-keeps-pr-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This separation keeps programs readable to an agent while allowing the JSON document and renderer to retain richer engine concerns. In particular, activations are inferred from synchronous calls and returns rather than stated in the grammar."
        }
      ],
      "children": []
    },
