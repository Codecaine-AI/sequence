      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "alt guard=available\n  2 > 1 text=success\nelse guard=retryable\n  2 --> 1 text=retry\nelse\n  2 --> 1 text=failure"
        }
