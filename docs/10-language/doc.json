    "b-language-the-language-is-a-derive-2": {
      "id": "b-language-the-language-is-a-derive-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The language is a derived, disposable view of a sequence document. The serializer writes it, an agent rewrites the whole program, and the parser expands it back into document structure. The JSON "
        },
        {
          "insert": "SequenceDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " remains the source of truth. The language is optimized for "
        },
        {
          "insert": "clarity over compression",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": every value is labeled, every reference is a declared number, and indentation is the only nesting syntax."
        }
      ],
      "children": []
    },
    "b-language-a-program-has-three-part-3": {
      "id": "b-language-a-program-has-three-part-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A program has three parts, in this order:"
        }
      ],
      "children": []
    },
    "b-language-the-optional-title-4": {
      "id": "b-language-the-optional-title-4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The optional title.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " One "
        },
        {
          "insert": "title",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " line, present if and only if the document has a title."
        }
      ],
      "children": []
    },
    "b-language-participants-decla-6": {
      "id": "b-language-participants-decla-6",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Participants.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Declarations in left-to-right column order."
        }
      ],
      "children": []
    },
    "b-language-the-sequence-one-7": {
      "id": "b-language-the-sequence-one-7",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The sequence.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " One "
        },
        {
          "insert": "seq",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " block containing messages, combined fragments, and notes in top-to-bottom order."
        }
      ],
      "children": []
    },
    "b-language-in-canonical-form-the-t-9": {
      "id": "b-language-in-canonical-form-the-t-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "In canonical form, the title (when present) is immediately followed by the participant declarations. Exactly one blank line separates the participants from "
        },
        {
          "insert": "seq",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Blank lines do not create nesting. Tabs are an error. Indentation is exactly 2 spaces per level. "
        },
        {
          "insert": "seq",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is at the left margin, and every item in it is indented by at least one level."
        }
      ],
      "children": []
    },
    "b-language-reference-numbers-10": {
      "id": "b-language-reference-numbers-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Reference numbers"
        }
      ],
      "children": []
    },
    "b-language-every-participant-line-d-11": {
      "id": "b-language-every-participant-line-d-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every participant line declares a positive integer. Numbers are dense and in declaration order: "
        },
        {
          "insert": "1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "2",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", …, "
        },
        {
          "insert": "n",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". All messages and notes refer to participants by those numbers. The number "
        },
        {
          "insert": "is",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " the participant's identity in the program. "
        },
        {
          "insert": "text=",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is only its short name. Several participants may share the same text without ambiguity."
        }
      ],
      "children": []
    },
    "b-language-numbers-are-a-projection-12": {
      "id": "b-language-numbers-are-a-projection-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Numbers are a projection detail. Parsing assigns participant ids "
        },
        {
          "insert": "p1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through "
        },
        {
          "insert": "pn",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from their numbers. Messages, fragments, and notes receive deterministic ids "
        },
        {
          "insert": "m1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "…, "
        },
        {
          "insert": "f1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "…, and "
        },
        {
          "insert": "n1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "… in encounter order. Document ids and item ids are never written in the language."
        }
      ],
      "children": []
    },
    "b-language-the-optional-title-13": {
      "id": "b-language-the-optional-title-13",
      "type": "heading",
      "props": {
        "level": 2
