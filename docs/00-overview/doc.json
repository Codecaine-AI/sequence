    "b-00-overview-sequence-is-a-sequence-d-2": {
      "id": "b-00-overview-sequence-is-a-sequence-d-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sequence is a sequence-diagram engine ("
        },
        {
          "insert": "@codecaine-ai/sequence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") plus a standalone studio ("
        },
        {
          "insert": "@codecaine-ai/sequence-studio",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Its JSON "
        },
        {
          "insert": "SequenceDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the source of truth. The text language is a compact, disposable projection for agents: serialize the current document, rewrite the whole program, parse it, then replace the document structure while preserving its separately managed style."
        }
      ],
      "children": []
    },
    "b-00-overview-the-engine-follows-one-d-3": {
      "id": "b-00-overview-the-engine-follows-one-d-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The engine follows one deterministic path:"
        }
      ],
      "children": []
    },
    "b-00-overview-text-4": {
      "id": "b-00-overview-text-4",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "SequenceDocument (JSON source of truth)\n  │\n  ├─ serializeSequenceProgram ─→ disposable text projection\n  │                                  │\n  │                             whole-program agent rewrite\n  │                                  │\n  │                         parseSequenceProgram\n  │                                  │\n  │                    validated replacement structure\n  │                     + preserved document style/id\n  │                                  │\n  └────────────────────────────────────────┘\n                         │\n                   layoutSequence\n             deterministic geometry only\n                         │\n                    SVG rendering\n                         │\n          SequenceViewer / standalone SVG string"
        }
      ],
      "children": []
    },
    "b-00-overview-structure-flows-into-lay-5": {
      "id": "b-00-overview-structure-flows-into-lay-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Structure flows into layout. Coordinates never flow back into the document or language. "
        },
        {
          "insert": "layoutSequence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is pure and DOM-free. Its only environment input is text metrics."
        }
      ],
      "children": []
    },
    "b-00-overview-structure-flows-into-lay-5-p2": {
      "id": "b-00-overview-structure-flows-into-lay-5-p2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "By default widths and line breaks come from "
        },
        {
          "insert": "@codecaine-ai/text-measure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which is exact once the host loads its bundled fonts ("
        },
        {
          "insert": "useHarfBuzz()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in Bun / Node, "
        },
        {
          "insert": "fonts.css",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus "
        },
        {
          "insert": "useBrowserFonts()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in a browser) and approximate until then. "
        },
        {
          "insert": "SequenceDiagram",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lays out again whenever text-measure switches backend. Hosts that call "
        },
        {
          "insert": "layoutSequence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " themselves re-run it on "
        },
        {
          "insert": "onBackendChange",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-structure-flows-into-lay-5-p3": {
      "id": "b-00-overview-structure-flows-into-lay-5-p3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A host can instead pass a measuring function, or "
        },
        {
          "insert": "{ measure, wrap }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when it also breaks lines. The same input threads through "
        },
        {
          "insert": "SequenceViewer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "SequenceDiagram",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "renderSequenceSvgString",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "SEQUENCE_TYPOGRAPHY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " gives the font of every text role, and layout and the SVG renderer both read it, so text is measured in the font it is drawn in."
        }
      ],
      "children": []
    },
    "b-00-overview-structure-flows-into-lay-5-p4": {
      "id": "b-00-overview-structure-flows-into-lay-5-p4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Single-line labels collapse runs of spaces and line breaks to one space ("
        },
        {
          "insert": "singleLineText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), code points XML forbids are dropped, and the renderer emits that same string. If text-measure's line breaking fails (for example when another library initialized Pretext first), notes and titles break greedily over measured widths and the console gets one warning. SVG text uses "
        },
        {
          "insert": "text-rendering=\"geometricPrecision\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so Chromium keeps the measured widths when a diagram is displayed scaled. Rendering consumes the resulting geometry without becoming a second layout engine."
        }
      ],
      "children": []
    },
    "b-00-overview-notes-keep-their-fixed-1-6": {
      "id": "b-00-overview-notes-keep-their-fixed-1-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Notes keep their fixed 160 px column and wrap inside it, growing taller per line. Explicit line breaks render as separate lines, and space runs collapse as in CSS "
        },
        {
          "insert": "white-space: pre-line",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Columns widen so side and over notes stop short of the neighbouring lifeline and its activation bars, and so message labels keep their room when nested activations move an arrow's end inward. A title wider than the diagram wraps at the content width and never widens the diagram. The participant row sits below the title's last line, at least one row gap below the top margin."
        }
      ],
      "children": []
    },
    "b-00-overview-inherited-layout-lab-con-7": {
      "id": "b-00-overview-inherited-layout-lab-con-7",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Inherited layout-lab conventions"
        }
      ],
      "children": []
    },
    "b-00-overview-the-language-carries-for-8": {
      "id": "b-00-overview-the-language-carries-for-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The language carries forward the canvas layout-lab v3 approach:"
        }
      ],
      "children": []
    },
    "b-00-overview-json-remains-authorita-9": {
      "id": "b-00-overview-json-remains-authorita-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
