    "b-00-overview-the-engine-is-a-raw-type-24": {
      "id": "b-00-overview-the-engine-is-a-raw-type-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The engine is a raw-TypeScript workspace package with granular exports for the schema, language, layout, agent schema, and theme. The studio is a consumer of that public surface, not a privileged rendering or parsing implementation."
        }
      ],
      "children": []
    },
    "b-00-overview-future-docs-system-integ-25": {
      "id": "b-00-overview-future-docs-system-integ-25",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Future docs-system integration"
        }
      ],
      "children": []
    },
    "b-00-overview-the-intended-docs-system-26": {
      "id": "b-00-overview-the-intended-docs-system-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The intended docs-system integration keeps the same narrow boundaries:"
        }
      ],
      "children": []
    },
    "b-00-overview-text-27": {
      "id": "b-00-overview-text-27",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "docs host\n  ├─ external/sequence             sequence repository as a submodule\n  ├─ agent-schema-only boundary   operations exposed to the docs model\n  └─ host-injected embed          host supplies document/state plumbing\n       └─ SequenceViewer          engine-owned read-only SVG surface"
        }
      ],
      "children": []
    },
    "b-00-overview-the-docs-model-should-se-28": {
      "id": "b-00-overview-the-docs-model-should-se-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The docs model should see only the agent operation schema: rewrite the complete program with "
        },
        {
          "insert": "setProgram",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", adjust presentation with "
        },
        {
          "insert": "setStyle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or set the title explicitly. It should not depend on studio state, renderer internals, or layout coordinates. The host owns persistence and injects the current document into the embed. Sequence owns validation, deterministic expansion, and drawing."
        }
      ],
      "children": []
    },
    "b-00-overview-that-arrangement-permits-29": {
      "id": "b-00-overview-that-arrangement-permits-29",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "That arrangement permits the repository to live at "
        },
        {
          "insert": "external/sequence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " without coupling the docs system to Sequence's workspace tooling or editor UI. It also preserves the core invariant across standalone and embedded use: JSON is the source of truth, text is disposable, and styling stays outside the language."
        }
      ],
      "children": []
    }
  }
}
