    "b-language-seq-is-written-at-the-24": {
      "id": "b-language-seq-is-written-at-the-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "seq",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is written at the left margin. Its items are ordered top to bottom and indented one level. Nested operand items are indented one additional level. Dedentation closes a construct. There is no "
        },
        {
          "insert": "end",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keyword."
        }
      ],
      "children": []
    },
