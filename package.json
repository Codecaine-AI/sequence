{
  "name": "codecaine-sequence",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test packages/sequence/src",
    "typecheck": "bun run typecheck:sequence && bun run typecheck:studio",
    "typecheck:sequence": "bunx --bun tsc -p packages/sequence/tsconfig.json --noEmit",
    "typecheck:studio": "bunx --bun tsc -p packages/studio/tsconfig.json --noEmit",
    "dev:studio": "bun run --cwd packages/studio dev"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
