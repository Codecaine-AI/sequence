    "cat-lead": {
      "id": "cat-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Judges score 9 categories from 1 to 10. The Meaning group checks the diagram against the brief, and the Look group checks only the PNG."
        }
      ],
      "children": []
    },
    "cat-table": {
      "id": "cat-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Group",
          "Category",
          "The judge checks"
        ],
        "rows": [
          [
            "Meaning",
            "System fidelity",
            "The flow matches the system, and each arrow kind and guard is right"
          ],
          [
            "Meaning",
            "Requirement coverage",
            "Every required step in the brief is on the diagram"
          ],
          [
            "Meaning",
            "Scope discipline",
            "The diagram adds nothing the brief does not ask for"
          ],
          [
            "Look",
            "Readability",
            "A new viewer can follow the flow at arm's length"
          ],
          [
            "Look",
            "Participant order",
            "Column order keeps most arrows short and moving left to right"
          ],
          [
            "Look",
            "Rhythm and fragments",
            "Rows have a steady rhythm, and frames, guards and bars read clearly"
          ],
          [
            "Look",
            "Color and contrast",
            "Color carries meaning, and text stays legible"
          ],
          [
            "Look",
            "Typography and labels",
            "Labels are short, never clipped, and never cross a lifeline"
          ],
          [
            "Look",
            "Craft",
            "The diagram looks finished, ready to put in a doc"
