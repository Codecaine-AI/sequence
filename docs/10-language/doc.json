    "b-language-fragments-are-indentatio-32": {
      "id": "b-language-fragments-are-indentatio-32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Fragments are indentation-nested containers. "
        },
        {
          "insert": "alt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "opt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "loop",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " each begin an operand, and the operand's items are indented one more level."
        }
      ],
      "children": []
    },
