    },
    "b-language-an-alt-has-one-or-more-35": {
      "id": "b-language-an-alt-has-one-or-more-35",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An "
        },
        {
          "insert": "alt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has one or more operands. Its first line is "
        },
        {
          "insert": "alt guard=<v>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Further operands use "
        },
        {
          "insert": "else",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "else guard=<v>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at the same indentation as the "
        },
        {
          "insert": "alt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A non-first operand may omit its guard. An "
        },
        {
          "insert": "else",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is legal only when it is at the same indentation as its "
        },
        {
          "insert": "alt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and directly follows the first operand's items or the preceding alternative operand's items. It cannot stand alone."
        }
      ],
      "children": []
    },
    "b-language-opt-optional-behavio-36": {
