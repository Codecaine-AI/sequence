      "children": []
    },
    "b1b": {
      "id": "b1b",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep the briefs outside the repo, and pass their folder with "
        },
        {
          "insert": "--briefs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
