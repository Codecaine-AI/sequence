    "b-language-the-title-line-is-legal-15": {
      "id": "b-language-the-title-line-is-legal-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The title line is legal only as the first line. Its value is a JSON string. The line is emitted if and only if "
