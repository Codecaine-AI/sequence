    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A quality climb redraws the same sequence briefs every round, and a council of models scores the diagrams. Between rounds, you change the language doc that "
        },
        {
          "insert": "WRITING_GUIDE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " renders, the layout, the theme or the lints. You keep a change only when the scores rise and the guard still passes. The "
        },
        {
          "insert": "packages/climb",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " CLI runs each round."
        }
      ],
      "children": []
    },
    "round-h": {
      "id": "round-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "One Round"
        }
      ],
      "children": []
    },
    "round-lead": {
      "id": "round-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "climb round",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " command runs these steps for each draw. Each step is also its own command, and "
        },
        {
          "insert": "packages/climb/README.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lists every flag."
        }
      ],
      "children": []
    },
    "round-outline": {
      "id": "round-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "One Climb Round",
            "steps": [
              {
                "text": "`climb setup` copies each `brief.md` into the run folder."
              },
              {
                "text": "`climb draw` starts one headless Claude Code drawer per brief, Opus 5.5 at medium effort, with the docs-system MCP and Read on the render folder."
              },
              {
                "text": "`climb render` renders each program with `renderSequenceSvgString` and turns the SVG into `diagram.png`."
              },
              {
                "text": "`climb judge` sends each PNG to each judge in a fresh CLI process and checks each reply against the score schema."
              },
              {
                "text": "`climb score` averages the draws per brief and writes `table.md` and `gate.json`."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "briefs-h": {
      "id": "briefs-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Briefs and Judges"
        }
      ],
      "children": []
    },
