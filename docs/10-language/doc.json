    "b-language-an-opt-has-exactly-one-38": {
      "id": "b-language-an-opt-has-exactly-one-38",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An "
        },
        {
          "insert": "opt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has exactly one operand and requires "
        },
        {
          "insert": "guard=<v>",
          "attributes": {
            "code": true
          }
        },
