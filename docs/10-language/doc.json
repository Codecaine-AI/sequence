    "b-language-the-only-explicit-non-de-20": {
      "id": "b-language-the-only-explicit-non-de-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The only explicit non-default kind is "
        },
        {
          "insert": "kind=actor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "kind=participant",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the default and is omitted in canonical output. Participant array order is therefore both declaration order and left-to-right column order."
        }
      ],
      "children": []
